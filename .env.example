# Copy to .env and fill in. Never commit the real .env file.

# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:4180/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret for oauth2-proxy's session cookie, e.g: openssl rand -base64 32 | head -c 32 | base64
OAUTH2_PROXY_COOKIE_SECRET=
