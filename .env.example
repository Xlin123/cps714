# Copy to .env and adjust. Never commit the real .env file.
# All variables are optional; defaults are shown.

# SQLAlchemy async URL for the database.
LMS_DB_URL=sqlite+aiosqlite:///./lms.sqlite3

# Session cookie is HTTPS-only by default. Set to false for plain-HTTP local dev.
LMS_COOKIE_SECURE=true

# How long a login lasts before the user must sign in again.
LMS_SESSION_LIFETIME_SECONDS=86400

# At startup, add sample books and create member@/librarian@/admin@example.com
# (password "library-demo") with fill-in buttons on the login page.
# Never enable in production.
LMS_DEMO_DATA=false

# Directory of the built React app to serve at "/". Leave unset when using Vite.
# LMS_CLIENT_DIST=../client/dist
